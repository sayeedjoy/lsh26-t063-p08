# Copy to frontend/.env if you need it. For local development you usually don't.
#
# Local dev (`pnpm run dev`): Vite proxies /api to the backend, so the app talks
# to it same-origin and nothing here needs setting.

# Where the Vite dev server proxies /api to (dev only, never in the bundle).
# API_PROXY_TARGET=http://localhost:3000

# Build-time fallback for the API origin. Baked into the bundle, so it needs a
# rebuild to change — prefer the runtime API_URL below in containers.
# VITE_API_URL=https://api.example.com

# --- Container runtime (this is the one Dokploy wants) ------------------
# API_URL is read by server.mjs at request time and served as /env.js, so the
# same built image can point at any backend. Set it on the frontend service to
# the backend's public URL, and set CORS_ORIGIN on the backend to this app's URL.
#   API_URL=https://api.example.com
