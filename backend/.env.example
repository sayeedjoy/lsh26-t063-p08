# Copy to backend/.env and fill in. Never commit the real file.
# Real environment variables (Docker, Dokploy) always take precedence over this file.

# PostgreSQL connection string. Leave unset to run without persistence:
# grading, traces, checking lists and the calculator all still work.
DATABASE_URL=postgres://p08:p08@localhost:5432/p08

# Force TLS when the URL has no ?sslmode= (some managed providers need this).
# DATABASE_SSL=true

# Port to listen on.
# PORT=3000

# Origins allowed to call this API from a browser, comma-separated.
#
# REQUIRED in the split deployment: the UI is its own container on its own
# domain, so every API call is cross-origin. Set this to the frontend's public
# URL — scheme + host, no trailing path:
#   CORS_ORIGIN=https://results.example.com
# `*` allows any origin (fine here — no cookies, no auth — but less tight).
# Unset means no CORS headers, which is correct only if something is serving
# the UI and the API on one origin.
# CORS_ORIGIN=https://results.example.com

# Path to the dataset JSON. Defaults to backend/data/.
# DATA_FILE=/absolute/path/to/P08_school_results_public.json
