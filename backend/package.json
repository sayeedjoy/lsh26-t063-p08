{
  "name": "p08-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/*.test.js dist/engine/*.test.js",
    "export": "node dist/export.js",
    "docker:build": "docker build -t p08-backend .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env p08-backend"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "~6"
  },
  "packageManager": "pnpm@10.30.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
